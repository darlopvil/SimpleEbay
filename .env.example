# Copiar a .env (chmod 600) y rellenar. Nunca subir .env al repositorio.

# Keyset de producción de https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Destino usado para calcular gastos de envío, tasas de importación y fechas
# de entrega. Sin país, la API no devuelve esos datos.
SIMPLEEBAY_ENVIO_PAIS=ES
SIMPLEEBAY_ENVIO_CP=28001

# Zona horaria para mostrar el cierre de las subastas.
TZ=Europe/Madrid

# SIMPLEEBAY_HOST=0.0.0.0
# SIMPLEEBAY_PORT=8080
